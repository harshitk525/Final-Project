# ==============================================================================
# VEKTOR BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your credentials
# ==============================================================================

# 1. ENTER YOUR POSTGRESQL PASSWORD HERE:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_actual_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vektor_db

# 2. ENTER YOUR LLM API KEY HERE:
# Free Gemini Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Or OpenAI Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. ENTER MAPBOX ACCESS TOKEN HERE (Optional Vector Basemap & Directions):
# Free Mapbox Token: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=
ORS_API_KEY=

# 4. ROUTING & SERVER SETTINGS:
OSRM_BASE_URL=http://router.project-osrm.org
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True

# 4. CORS Allowed Origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
