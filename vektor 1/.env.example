# ==============================================================================
# VEKTOR SMART MOBILITY — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Vektor works 100% OUT OF THE BOX without any API keys using resilient,
# zero-key public endpoints (BigDataCloud client geocoding, CartoDB/OSM tiles,
# and client-side multimodal step-free routing algorithms).
#
# If you have custom API keys for enterprise providers, specify them below:
# All variables in Vite MUST start with 'VITE_' to be accessible in the browser!
# ==============================================================================

# 1. Reverse Geocoding & Address Lookup (Optional)
# Supported providers: Geoapify, LocationIQ, OpenCage
# Leave blank to use zero-key high-speed BigDataCloud client engine
VITE_GEOCODING_API_KEY=

# 2. Map Tiles & Vector Maps (Optional)
# Supported providers: Mapbox (pk.eyJ1...), MapTiler (https://cloud.maptiler.com)
# Leave blank to use built-in CartoDB & OpenStreetMap tile CDN
VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=

# 3. Routing Engine & Navigation Directions (Optional)
# Supported providers: OpenRouteService (ORS), GraphHopper, or custom OSRM backend
# Leave blank to use built-in Multimodal Step-Free routing engine
VITE_ORS_API_KEY=
VITE_ROUTING_BACKEND_URL=

# 4. Disruption Intelligence & AI Scoring Backend (Optional)
# Point to your FastAPI backend if running (e.g. http://localhost:8000)
VITE_FASTAPI_URL=http://localhost:8000
